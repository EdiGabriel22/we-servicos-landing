---
import { asset, whatsappLink } from '../lib';
---

<section class="cta" aria-labelledby="cta-title">
  <img class="cta__bg" src={asset('img/cta.jpg')} alt="" loading="lazy" />
  <div class="cta__overlay" aria-hidden="true"></div>

  <div class="container cta__content reveal">
    <h2 class="cta__title" id="cta-title">Precisa de uma equipe de confiança?</h2>
    <p class="cta__text">
      Solicite um orçamento agora mesmo. Respondemos em até 1 hora durante o horário comercial, e operamos 7 dias por
      semana para atender sua demanda.
    </p>
    <div class="cta__actions">
      <a href="#contato" class="btn btn--orange btn--lg">
        <img src={asset('icons/clipboard.svg')} alt="" />
        Solicitar Orçamento
      </a>
      <a href={whatsappLink()} class="btn btn--green btn--lg" target="_blank" rel="noopener">
        <img src={asset('icons/whatsapp-white.svg')} alt="" />
        Falar no WhatsApp
      </a>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding-block: 100px;
    border-top: 4px solid var(--orange);
  }

  .cta__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }

  .cta__overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.85;
    background: linear-gradient(156deg, var(--blue) 0%, rgba(13, 42, 115, 0.975) 35%, rgba(7, 12, 24, 0.95) 70%);
  }

  .cta__content {
    max-width: 848px;
    text-align: center;
  }

  .cta__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(36px, 5vw, 58.32px);
    line-height: 1.05;
    letter-spacing: -1px;
  }

  .cta__text {
    margin-top: 20px;
    color: rgba(255, 255, 255, 0.75);
    font-size: 18px;
    line-height: 1.7;
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    margin-top: 48px;
  }

  @media (max-width: 560px) {
    .cta {
      padding-block: 72px;
    }

    .cta__text {
      font-size: 16px;
    }

    .cta__actions .btn {
      flex: 1 1 100%;
      padding-inline: 24px;
    }
  }
</style>
